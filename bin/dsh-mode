#!/bin/sh
# dsh-mode — 在「桌面版」和「手机用的 Web 版」之间切换。
#
#   dsh-mode          看当前谁在跑（默认）
#   dsh-mode app      停 Web 服务，打开桌面版
#   dsh-mode web      退出桌面版，起 Web 服务，打印手机地址
#   dsh-mode url      只打印手机地址
#
# 两者不能同时持有会话写锁，所以每次切换都要先把对面停干净。
set -u

LABEL=com.deepseek.dsh-web
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PORT="${DSH_WEB_PORT:-8443}"
BUNDLE=com.deepseek.dsh
APP="/Applications/DeepSeek Harness.app"
LOG="${DSH_WEB_LOG:-$HOME/Library/Logs/dsh-web.log}"
UID_NUM=$(id -u)

say() { printf '%s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit 1; }

app_running() { [ -n "$(/usr/bin/lsappinfo find bundleid=$BUNDLE 2>/dev/null)" ]; }
svc_loaded() { /bin/launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1; }
svc_pid() { /bin/launchctl print "gui/$UID_NUM/$LABEL" 2>/dev/null | /usr/bin/awk '/^[[:space:]]*pid = /{print $3; exit}'; }
port_pid() { /usr/sbin/lsof -t -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | /usr/bin/head -n 1; }
last_url() { /usr/bin/grep -o 'dsh web: http[^[:space:]]*' "$LOG" 2>/dev/null | /usr/bin/tail -n 1 | /usr/bin/sed 's/^dsh web: //'; }

lock_holders() {
	set -- "${DSH_HOME:-$HOME/.dsh}"/sessions/*/*/session.lock
	[ -e "$1" ] || return 0
	/usr/sbin/lsof -t "$@" 2>/dev/null | /usr/bin/sort -u | /usr/bin/tr '\n' ' ' | /usr/bin/sed 's/ $//'
}

# wait_until <秒> <命令...>：命令成功即返回 0
wait_until() {
	limit=$1
	shift
	i=0
	while [ "$i" -lt "$limit" ]; do
		"$@" && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

not_running() { ! app_running; }
has_port() { [ -n "$(port_pid)" ]; }
no_port() { [ -z "$(port_pid)" ]; }
no_locks() { [ -z "$(lock_holders)" ]; }

# 重载服务：bootout + bootstrap，而不是 kickstart。
# kickstart 只是让旧配置再跑一遍；plist 里改过的环境变量、路径要重新读，
# 只有 bootstrap 会做。web / restart 都走这条，避免两边行为不一致。
reload_service() {
	if svc_loaded; then
		say "重载服务（bootout + bootstrap，会重读 plist）…"
		/bin/launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
		wait_until 10 no_port || true
	else
		say "服务没在跑，直接启动…"
	fi
	/bin/launchctl bootstrap "gui/$UID_NUM" "$PLIST" 2>/dev/null || die "bootstrap 失败：$PLIST"
}

usage() {
	/bin/cat <<'EOF'
dsh-mode — 在「桌面版」和「手机用的 Web 版」之间切换。

  dsh-mode          看当前谁在跑（默认）
  dsh-mode app      停 Web 服务，打开桌面版
  dsh-mode web      退出桌面版，起 Web 服务，打印手机地址
  dsh-mode restart  重启 Web 服务（升级 App 后用这个）
  dsh-mode url      只打印手机地址

两者不能同时持有会话写锁，所以每次切换都要先把对面停干净。
EOF
}

cmd_status() {
	if app_running; then say "桌面版：运行中"; else say "桌面版：未运行"; fi
	if svc_loaded; then
		sp=$(svc_pid)
		say "Web 服务：已加载${sp:+，运行中（pid $sp）}"
	else
		say "Web 服务：未加载"
	fi
	pp=$(port_pid)
	[ -n "$pp" ] && say "端口 $PORT：被 pid $pp 占着"
	url=$(last_url)
	[ -n "$url" ] && say "最近地址：$url"
	return 0
}

cmd_app() {
	if svc_loaded; then
		say "停 Web 服务…"
		/bin/launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
		wait_until 20 no_port || say "注意：端口 $PORT 还被 pid $(port_pid) 占着"
	fi
	if app_running; then
		say "桌面版已在运行，切到前台"
	else
		say "启动桌面版…"
	fi
	/usr/bin/open -a "$APP" || die "打不开 $APP"
	say "可以了。"
}

cmd_web() {
	if app_running; then
		say "退出桌面版…"
		/usr/bin/osascript -e "tell application id \"$BUNDLE\" to quit" >/dev/null 2>&1 || true
		if ! wait_until 45 not_running; then
			die "桌面版没退出（可能还有任务在跑或弹了确认框）；在 App 里手动 Quit 后重试"
		fi
		say "桌面版已退出"
	fi
	if [ -n "$(lock_holders)" ]; then
		say "等会话锁释放（PID $(lock_holders)）…"
		wait_until 30 no_locks || die "会话锁还被 pid $(lock_holders) 占着，稍后再试"
	fi
	[ -f "$PLIST" ] || die "找不到 $PLIST，先跑 sh install.sh"
	reload_service
	if ! wait_until 90 has_port; then
		say "服务没起来，日志最后几行：" >&2
		/usr/bin/tail -n 15 "$LOG" >&2 2>/dev/null
		exit 1
	fi
	say "已启动。手机打开这条（一次即可）："
	say "  $(last_url)"
}

cmd_restart() {
	if app_running; then
		die "桌面版在跑，先跑 dsh-mode web 切过来"
	fi
	# bootout + bootstrap（而不是 kickstart），这样 plist 里改过的环境变量才会重新读取。
	[ -f "$PLIST" ] || die "找不到 $PLIST，先跑 sh install.sh"
	reload_service
	if ! wait_until 90 has_port; then
		say "服务没起来，日志最后几行：" >&2
		/usr/bin/tail -n 15 "$LOG" >&2 2>/dev/null
		exit 1
	fi
	say "已重启。"
	cmd_url
}

cmd_url() {
	if command -v dsh-web-url >/dev/null 2>&1; then
		exec dsh-web-url
	fi
	url=$(last_url)
	[ -n "$url" ] || die "还没有地址，先跑 dsh-mode web"
	say "$url"
}

case "${1:-status}" in
	app | desktop) cmd_app ;;
	web | phone) cmd_web ;;
	restart | reload) cmd_restart ;;
	status) cmd_status ;;
	url) cmd_url ;;
	-h | --help | help) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
